# ==========================================
# iTechSolution — environment variable template
# Copy this file to .env.local for local development.
# Replace placeholders with your own values.
# NEVER commit .env.local or real credentials.
# ==========================================

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Better Auth — generate a strong, unique secret (32+ random bytes)
BETTER_AUTH_SECRET=replace_with_a_strong_random_secret

# Neon PostgreSQL
# Use your Neon connection string. Keep it private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Include only if your client-side code uses it:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Google Search Console (optional; only if configured in the app)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code

# Stripe (optional; only if payment integration uses these variables)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
